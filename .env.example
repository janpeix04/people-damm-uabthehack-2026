# =================================================================
# Configuración del Motor n8n Local
# =================================================================
N8N_API_URL=http://localhost:5678/api/v1
N8N_API_KEY=your_n8n_api_key_here

# Token compartido entre n8n y su task runner (docker-compose). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
N8N_RUNNERS_AUTH_TOKEN=change_me_generate_a_random_hex_token

# Opcional: abrir n8n a la red local (otros dispositivos). Por defecto solo localhost.
# N8N_BIND=0.0.0.0
# N8N_PUBLIC_URL=http://<IP_DE_ESTE_EQUIPO>:5678/

# Opcional: puerto del frontend en Docker (por defecto 8080)
# FRONTEND_PORT=8080

# =================================================================
# LLM Oficial UAB The Hack! 2026 (Servido en GPUs DCC)
# =================================================================
LLM_BASE_URL=https://dcc-llm-gw.uab.cat/uabthehack/v1
LLM_API_KEY=your_uab_hackathon_llm_key_here
LLM_MODEL=ornith

# =================================================================
# Typeform API (Publicación Automatizada de Microconsultas)
# =================================================================
TYPEFORM_TOKEN=your_typeform_personal_access_token_here

# =================================================================
# Microsoft 365 / Teams Webhook (Opcional - Difusión Corporativa)
# =================================================================
TEAMS_WEBHOOK_URL=https://your-tenant.webhook.office.com/webhookb2/your_incoming_webhook_url

# =================================================================
# PostgreSQL — Base de Datos People Listening Platform (Damm Pulse)
# =================================================================
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=54322
POSTGRES_DB=damm_pulse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
