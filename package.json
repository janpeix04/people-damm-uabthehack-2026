{
  "name": "uab-the-hack-damm-n8n",
  "version": "1.0.0",
  "description": "Sistema de Escucha Activa y People Analytics para Damm en n8n - The Hack! UAB 2026",
  "type": "module",
  "scripts": {
    "n8n:up": "docker compose up -d --build",
    "n8n:down": "docker compose down",
    "n8n:logs": "docker compose logs -f n8n",
    "frontend:logs": "docker compose logs -f frontend",
    "postgres:logs": "docker compose logs -f postgres",
    "db:init": "node scripts/init_postgres_db.js --reset",
    "db:status": "node scripts/init_postgres_db.js",
    "build:mcp": "npm --prefix mcp-n8n-local ci && npm --prefix mcp-n8n-local run build",
    "setup:workflows": "node scripts/setup_local.js",
    "test": "node --test tests/**/*.test.js",
    "test:security": "node --test tests/01_security_leak_audit.test.js",
    "test:schemas": "node --test tests/02_n8n_schemas_validator.test.js",
    "test:logic": "node --test tests/03_workflow_logic_units.test.js",
    "test:e2e": "node --test tests/04_n8n_live_execution.test.js"
  },
  "keywords": [
    "n8n",
    "people-analytics",
    "typeform",
    "uab-the-hack",
    "estrella-damm"
  ],
  "author": "The Hack! UAB Team",
  "license": "ISC",
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "pg": "^8.23.1"
  }
}
